# Copy these into Railway → Service → Variables (do not commit secrets).

NODE_ENV=production
TRUST_PROXY=1

# Railway injects PORT automatically; the app reads process.env.PORT.
# CHROME_PATH is set in the Dockerfile; override only if needed.
# CHROME_PATH=/usr/bin/chromium

# Public deployment: leave ALLOW_INTERNAL_SCANS unset (blocks private/localhost targets).

# Scan limits (tune for plan memory/CPU)
UNLIGHTHOUSE_MAX_ROUTES=25
UNLIGHTHOUSE_CONCURRENCY=1
SITE_SCAN_TIMEOUT_MS=2700000

# Rate limiting (production defaults are stricter)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000

# Optional AI insights
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# CSP console pass (set false to skip extra Puppeteer navigation on single-page scans)
# CSP_CONSOLE_AUDIT=true
# CSP_CONSOLE_TIMEOUT_MS=60000
# CSP_CONSOLE_SETTLE_MS=2000
