<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Lighthouse performance audits plus automated CSP console violation monitoring for agency site testing."
    />
    <title>Lighthouse + CSP Scanner</title>
    <%- include("_styles") %>
  </head>
  <body>
    <header>
      <h1>Lighthouse + CSP Scanner</h1>
      <p class="muted">
        Queue Lighthouse scans, monitor Content-Security-Policy console violations, and deliver agency-ready audit reports.
      </p>
      <nav>
        <a href="/">Dashboard</a>
        <a href="/?hasCsp=1">Runs with CSP issues</a>
        <a href="/api/runs">Runs API</a>
        <a href="/health">Health</a>
      </nav>
    </header>

    <% if (error) { %>
      <div class="flash-error"><%= error %></div>
    <% } %>
    <% if (notice) { %>
      <div class="flash-notice"><%= notice %></div>
    <% } %>

    <% if (hasCspFilter) { %>
      <div class="flash-notice">Showing recent runs with CSP console violations.</div>
    <% } %>

    <section class="panel csp-dashboard">
      <h2>CSP Monitor Overview</h2>
      <div class="score-grid">
        <div class="score">
          <div>Total violations (latest runs)</div>
          <strong><%= cspDashboard?.totalViolations ?? 0 %></strong>
        </div>
        <div class="score">
          <div>Sites with CSP issues</div>
          <strong><%= cspDashboard?.sitesWithIssues ?? 0 %></strong>
          <span class="muted small">of <%= cspDashboard?.monitoredSites ?? 0 %> monitored</span>
        </div>
        <div class="score">
          <div>6-run CSP trend</div>
          <strong>
            <% if ((cspDashboard?.trendDelta ?? 0) > 0) { %>+<%= cspDashboard.trendDelta %><% } else { %><%= cspDashboard?.trendDelta ?? 0 %><% } %>
          </strong>
          <span class="muted small">vs prior 6 runs</span>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="row" style="justify-content: space-between;">
        <div>
          <h2>Run Or Save A Site</h2>
          <p class="muted small">
            Full-site scans use Unlighthouse-style discovery, manual scans run through the background queue, and saved sites can be scheduled daily or weekly.
          </p>
        </div>
        <div class="status-pill <%= queueBusy ? "running" : "completed" %>">
          Queue <%= queueBusy ? "busy" : "idle" %>
        </div>
      </div>

      <form id="scan-form" method="post" action="/scan">
        <div class="grid">
          <div class="field">
            <label for="url">URL</label>
            <input id="url" name="url" type="url" required placeholder="https://example.com" value="<%= formDefaults.submittedUrl %>" />
          </div>
          <div class="field">
            <label for="clientName">Client</label>
            <input id="clientName" name="clientName" type="text" value="<%= formDefaults.clientName %>" />
          </div>
          <div class="field">
            <label for="siteLabel">Site label</label>
            <input id="siteLabel" name="siteLabel" type="text" placeholder="Homepage monitor" value="<%= formDefaults.siteLabel %>" />
          </div>
          <div class="field">
            <label for="alertWebhookUrl">Alert webhook URL</label>
            <input id="alertWebhookUrl" name="alertWebhookUrl" type="url" placeholder="https://hooks.slack.com/..." value="<%= formDefaults.alertWebhookUrl %>" />
          </div>
        </div>

        <div class="grid">
          <div class="field">
            <label for="formFactor">Device</label>
            <select id="formFactor" name="formFactor">
              <option value="mobile" <%= formDefaults.formFactor === "mobile" ? "selected" : "" %>>Mobile</option>
              <option value="desktop" <%= formDefaults.formFactor === "desktop" ? "selected" : "" %>>Desktop</option>
            </select>
          </div>
          <div class="field">
            <label for="scanMode">Scope</label>
            <select id="scanMode" name="scanMode">
              <option value="single" <%= formDefaults.scanMode === "single" ? "selected" : "" %>>Single page</option>
              <option value="site" <%= formDefaults.scanMode === "site" ? "selected" : "" %>>Full site</option>
            </select>
          </div>
          <div class="field">
            <label for="scheduleFrequency">Schedule</label>
            <select id="scheduleFrequency" name="scheduleFrequency">
              <option value="off" <%= formDefaults.scheduleFrequency === "off" ? "selected" : "" %>>Off</option>
              <option value="daily" <%= formDefaults.scheduleFrequency === "daily" ? "selected" : "" %>>Daily</option>
              <option value="weekly" <%= formDefaults.scheduleFrequency === "weekly" ? "selected" : "" %>>Weekly</option>
            </select>
          </div>
        </div>

        <h3>Thresholds</h3>
        <div class="grid">
          <div class="field">
            <label for="minPerformance">Min Performance</label>
            <input id="minPerformance" name="minPerformance" type="number" min="0" max="100" value="<%= formDefaults.thresholds.minPerformance %>" />
          </div>
          <div class="field">
            <label for="minAccessibility">Min Accessibility</label>
            <input id="minAccessibility" name="minAccessibility" type="number" min="0" max="100" value="<%= formDefaults.thresholds.minAccessibility %>" />
          </div>
          <div class="field">
            <label for="minBestPractices">Min Best Practices</label>
            <input id="minBestPractices" name="minBestPractices" type="number" min="0" max="100" value="<%= formDefaults.thresholds.minBestPractices %>" />
          </div>
          <div class="field">
            <label for="minSeo">Min SEO</label>
            <input id="minSeo" name="minSeo" type="number" min="0" max="100" value="<%= formDefaults.thresholds.minSeo %>" />
          </div>
          <div class="field">
            <label for="minOverall">Min Overall</label>
            <input id="minOverall" name="minOverall" type="number" min="0" max="100" value="<%= formDefaults.thresholds.minOverall %>" />
          </div>
          <div class="field">
            <label for="maxLcpMs">Max LCP (ms)</label>
            <input id="maxLcpMs" name="maxLcpMs" type="number" min="0" step="100" value="<%= formDefaults.thresholds.maxLcpMs %>" />
          </div>
          <div class="field">
            <label for="maxCls">Max CLS</label>
            <input id="maxCls" name="maxCls" type="number" min="0" step="0.01" value="<%= formDefaults.thresholds.maxCls %>" />
          </div>
          <div class="field">
            <label for="maxCspViolations">Max CSP console violations</label>
            <input id="maxCspViolations" name="maxCspViolations" type="number" min="0" step="1" value="<%= formDefaults.thresholds.maxCspViolations %>" />
          </div>
        </div>

        <div class="section-actions">
          <button type="submit" id="queue-btn">Queue Scan</button>
          <button type="submit" formaction="/sites" class="secondary">Save Site Monitor</button>
        </div>
      </form>
    </section>

    <section class="grid">
      <div class="card">
        <h2>Monitored Sites</h2>
        <% if (!sites.length) { %>
          <p class="muted">No saved sites yet.</p>
        <% } else { %>
          <ul class="list-clean">
            <% sites.forEach(function (site) { %>
              <% const cspSite = cspDashboard?.statusBySiteId?.[site.id]; %>
              <li>
                <div class="row" style="justify-content: space-between;">
                  <div>
                    <strong><a href="/sites/<%= site.id %>"><%= site.label %></a></strong><br />
                    <span class="muted small"><%= site.client?.name || "Unassigned" %> · <%= site.scanMode %> · <%= site.defaultFormFactor %></span>
                  </div>
                  <div class="row" style="gap: 0.35rem;">
                    <% if (cspSite && cspSite.count != null) { %>
                      <span class="status-pill <%= cspSite.hasIssue ? "failed" : "completed" %>">
                        CSP <%= cspSite.count %>
                      </span>
                    <% } else { %>
                      <span class="status-pill queued">CSP —</span>
                    <% } %>
                    <span class="status-pill <%= site.schedule?.frequency === "off" ? "queued" : "completed" %>">
                      <%= site.schedule?.frequency === "off" ? "manual" : site.schedule.frequency %>
                    </span>
                  </div>
                </div>
                <p class="small url"><%= site.url %></p>
                <div class="section-actions">
                  <a class="button-link secondary" href="/sites/<%= site.id %>">Settings</a>
                  <form method="post" action="/sites/<%= site.id %>/run">
                    <button type="submit">Run now</button>
                  </form>
                  <form
                    method="post"
                    action="/sites/<%= site.id %>/delete"
                    onsubmit="return confirm('Delete &quot;<%= site.label %>&quot; and all scan history? This cannot be undone.');"
                  >
                    <button type="submit" class="warn">Delete</button>
                  </form>
                </div>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>

      <div class="card">
        <h2>Recent Alerts</h2>
        <% if (!recentAlerts.length) { %>
          <p class="muted">No alerts fired yet.</p>
        <% } else { %>
          <ul class="list-clean">
            <% recentAlerts.forEach(function (alert) { %>
              <li>
                <strong><%= alert.title %></strong><br />
                <span class="muted small"><%= alert.site?.label || "Site" %> · <%= formatDate(alert.createdAt) %></span>
                <p class="small"><%= alert.message %></p>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </section>

    <section class="panel">
      <h2>Recent Jobs</h2>
      <% if (!recentJobs.length) { %>
        <p class="muted">No jobs have been queued yet.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Job</th>
              <th>Site</th>
              <th>Status</th>
              <th>Source</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% recentJobs.forEach(function (job) { %>
              <tr>
                <td><a href="/jobs/<%= job.id %>"><%= job.scanMode %> / <%= job.formFactor %></a></td>
                <td class="url"><%= job.site?.label || job.url %></td>
                <td><span class="status-pill <%= job.status %>"><%= job.status %></span></td>
                <td><%= job.source %></td>
                <td><%= formatDate(job.createdAt) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </section>

    <section class="panel">
      <h2>Recent Runs</h2>
      <% if (!recentRuns.length) { %>
        <p class="muted">No completed runs stored yet.</p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Run</th>
              <th>Site</th>
              <th>Overall</th>
              <th class="num">CSP</th>
              <th>Completed</th>
            </tr>
          </thead>
          <tbody>
            <% recentRuns.forEach(function (run) { %>
              <% const overall = run.scanMode === "site" ? run.summary?.avgScores?.overall : run.summary?.overall; %>
              <% const cspCount = run.summary?.csp?.count ?? 0; %>
              <tr>
                <td><a href="/runs/<%= run.id %>"><%= run.scanMode %> / <%= run.formFactor %></a></td>
                <td class="url"><%= run.site?.label || run.url %></td>
                <td class="num"><%= overall != null ? overall : "—" %></td>
                <td class="num">
                  <% if (cspCount > 0) { %>
                    <span class="status-pill failed"><%= cspCount %></span>
                  <% } else { %>
                    <span class="status-pill completed">0</span>
                  <% } %>
                </td>
                <td><%= formatDate(run.completedAt || run.createdAt) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </section>

    <script>
      (function () {
        var form = document.getElementById("scan-form");
        var btn = document.getElementById("queue-btn");
        if (!form || !btn) return;
        form.addEventListener("submit", function () {
          btn.disabled = true;
          btn.textContent = "Queueing…";
        });
      })();
    </script>
  </body>
</html>
